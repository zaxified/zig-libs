#!/usr/bin/env bash
# Run ONE module's test lane with everything -- producer AND reader -- inside a
# single capped cgroup, and print a bounded tail of the output.
#
#     scripts/modtest yaml                    # zig build test-yaml
#     scripts/modtest yaml -Doptimize=ReleaseFast
#     scripts/modtest --file probe.zig        # one-off `zig test FILE` (mutants)
#     scripts/modtest --file probe.zig -OReleaseFast
#     LINES=200 scripts/modtest yaml          # show more of the tail
#
# Why this exists, and why `scripts/capped zig build test-<m> | tail -20` is NOT
# the same thing:
#
#   `capped` puts the COMMAND in a memory-capped transient scope. A reader on
#   the other side of a pipe is not in that scope -- it is a child of the
#   caller's shell, which under an IDE is the EDITOR's own cgroup. So the cap
#   bounds the half that was never the problem.
#
#   2026-09-10, measured. An agent hand-built a MUTANT of one module file and
#   ran it the only way it had, which was neither a lane nor capped:
#       $ZIG test /tmp/.../mac_mutant.zig 2>&1 | tail -20
#   83 seconds later `tail` reached 19.4 GB of anonymous memory in about 110 seconds. The kernel
#   fired a GLOBAL oom-kill (31 GB of RAM, 512 MB of swap), killed `tail`, and
#   because that task lived inside `app-code-*.scope`, systemd tore the whole
#   VS Code scope down with it: "Failed with result 'oom-kill'", 20.2 G memory
#   peak. The editor died; the capped `zig` process was never even close to its
#   limit. `tail -N` is only bounded when the producer emits newlines -- one
#   unterminated line, or a runaway test that never stops writing, and `tail`
#   holds all of it in RAM. Two failures stacked: a bare `zig test` outside the
#   cap (the 15.4 GB desktop-killer shape `capped` exists for), and a reader the
#   cap could not have covered anyway. `--file` mode below closes the first by
#   giving one-file probes a lane of their own -- a rule agents cannot follow
#   without a tool is a rule that gets bypassed.
#
#   ⛔ And put the probe file in `.zig-cache/probe/`, not in a scratch directory
#   under `/tmp`: /tmp is tmpfs, so a mutant that writes without bound fills RAM
#   whether or not anything reads it.
#
# So: no pipe into an accumulating reader, ever. Output is redirected to a file
# on DISK (`.zig-cache/modtest/`, droppable scratch -- never `/tmp`, which is
# tmpfs, i.e. RAM), the whole pipeline runs inside ONE capped scope, and the
# byte budget for the log is enforced by `head -c`, which is O(1) in memory.
#
# Knobs (all optional):
#   ZIGLIBS_MEM_MAX      cgroup cap for the whole lane          (default 4G)
#   ZIGLIBS_MODTEST_LOG_MAX   byte budget for the log           (default 256M)
#   NICE                 niceness                               (default 15)
#   JOBS                 zig build -j                           (default 2)
#   LINES                lines of tail printed on success       (default 40)
#   ZIGLIBS_MODTEST_TIMEOUT   wall-clock limit: 900s for a lane, 120s for --file
#
# The 4G default is deliberately lower than `capped`'s 12G: this runner is for
# the fix campaign, where up to four agents run lanes at once on a desktop the
# user is sitting at. 4 x 4G leaves the editor and browser their half of RAM.
# A full `zig build test` across EVERY module peaks at 4.1 GiB, so 4G is ample
# for one module and still an order of magnitude under a runaway.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ $# -eq 0 ]]; then
    echo "usage: scripts/modtest MODULE [zig build args...]" >&2
    echo "       scripts/modtest --file PATH.zig [zig test args...]" >&2
    exit 2
fi

mode=lane
if [[ "$1" == "--file" ]]; then
    mode=file
    shift
    [[ $# -ge 1 ]] || { echo "modtest --file needs a path" >&2; exit 2; }
    probe="$1"
    module="$(basename "${probe%.zig}")"
else
    module="$1"
    probe=""
fi
shift

log_dir="$REPO_ROOT/.zig-cache/modtest"
mkdir -p "$log_dir"
log="$log_dir/$module.log"

# ⛔ One lane per module at a time. Two concurrent runs of the same module write
# the same log and clobber each other's result -- measured 2026-09-10, an agent
# lost a measurement twice that way and could not tell which run it was reading.
# `flock -n` on the log makes the second one say so instead of racing.
# ⛔⛔ The braces are load-bearing. `exec 9>>"$log.lock" 2>/dev/null` does NOT
# redirect stderr "for this exec" -- an `exec` with redirections and no command
# applies them to THE SHELL, permanently. Written that way (as it was from
# 2026-09-10 morning until it was caught that evening) every ⛔ this script
# prints -- TIMED OUT, the byte budget, the stray sweep, this very lock message
# -- went to /dev/null for the whole run. The tool's alarms were mute and its
# exit codes were the only thing left saying anything. Wrapping in a group
# scopes the redirect to the group and leaves the shell's own stderr alone.
{ exec 9>>"$log.lock"; } 2>/dev/null || true
if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
    echo "⛔ modtest $module is already running (log $log). Wait for it or use a different module." >&2
    exit 2
fi

: "${ZIGLIBS_MEM_MAX:=4G}"
: "${ZIGLIBS_MODTEST_LOG_MAX:=256M}"
: "${NICE:=15}"
: "${JOBS:=2}"
: "${LINES:=40}"
export ZIGLIBS_MEM_MAX

# Everything inside ONE scope: the build, the byte-budget filter, the redirect.
# The script re-execs ITSELF inside the scope rather than handing systemd a
# shell one-liner: `systemd-run` expands `${...}` in the command it is given, so
# a `${PIPESTATUS[0]}` written there dies as "invalid environment variable name"
# before bash ever sees it.
if [[ -z "${_ZL_MODTEST_INNER:-}" ]]; then
    export _ZL_MODTEST_INNER=1
    if [[ "$mode" == file ]]; then
        exec "$SCRIPT_DIR/capped" nice -n "$NICE" "$0" --file "$probe" "$@"
    fi
    exec "$SCRIPT_DIR/capped" nice -n "$NICE" "$0" "$module" "$@"
fi

# ⛔⛔ TWO separate holes, both measured 2026-09-10, both from one incident.
#
# (1) `timeout` kills the process it STARTED, and that is not the process that
#     loops. A `yaml` test binary spawned by a lane in worktree `c` outlived its
#     build by 2 h 52 min at 99.5% of one core, 532 MB RSS, zero bytes read or
#     written -- the shape no memory cap and no byte budget can see. Its parent
#     had been reaped, so it showed up reparented to `systemd --user`; and a
#     `systemd-run --scope` lives as long as ANY task in it, so the scope never
#     tore down either. The cap kept applying to a process nobody waited for.
#
# (2) Worse, and why a reaper AFTER the pipeline is not enough: the stray
#     inherits the pipe's write end, so `head` never sees EOF and the pipeline
#     never returns. Reproduced deliberately with a forked probe -- `zig test`
#     was killed at the 120s limit, `head -c 256M` was still blocked 7 minutes
#     later, and killing the stray by hand let the pipeline finish instantly.
#     The wait itself has to be bounded, not just the command.
#
# So: a watchdog sweeps our own cgroup once the limit is past. Sweeping the
# CGROUP rather than the process group is what makes it work regardless of who
# reparented the stray.

# Seconds from ZIGLIBS_MODTEST_TIMEOUT ("900s", "15m", or a bare number).
timeout_seconds() {
    local t="${1:-}" n unit
    n="${t%[smhd]}"
    unit="${t#$n}"
    [[ "$n" =~ ^[0-9]+$ ]] || { echo 900; return; }
    case "$unit" in
        m) echo $((n * 60)) ;;
        h) echo $((n * 3600)) ;;
        d) echo $((n * 86400)) ;;
        *) echo "$n" ;;
    esac
}

# Kill every task in our own cgroup except the PIDs named. Returns the count.
reap_cgroup() {
    local -a keep=("$@")
    local cg procs pid k skip
    cg=$(awk -F: '$1=="0"{print $3}' /proc/self/cgroup 2>/dev/null)
    procs="/sys/fs/cgroup${cg}/cgroup.procs"
    [[ -n "$cg" && -r "$procs" ]] || return 0

    local -a strays=()
    while read -r pid; do
        [[ -z "$pid" ]] && continue
        skip=
        for k in "${keep[@]}"; do [[ "$pid" == "$k" ]] && skip=1 && break; done
        [[ -n "$skip" ]] && continue
        kill -0 "$pid" 2>/dev/null || continue
        strays+=("$pid")
    done < "$procs"
    [[ ${#strays[@]} -eq 0 ]] && return 0

    for pid in "${strays[@]}"; do
        echo "   stray: $(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | cut -c1-100)" >&2
    done
    kill -TERM "${strays[@]}" 2>/dev/null
    sleep 2
    for pid in "${strays[@]}"; do
        kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
    done
    return "${#strays[@]}"
}

set -o pipefail

# Watchdog: once the limit plus a grace period is past, sweep the cgroup. This
# is what unblocks `head` when a stray is holding the pipe open -- see (2) above.
limit_s=$(timeout_seconds "${ZIGLIBS_MODTEST_TIMEOUT:-$([[ "$mode" == file ]] && echo 120s || echo 900s)}")
(
    sleep $((limit_s + 30))
    # ⚠ Mark BEFORE sweeping, not after. Killing the pipeline lets the main
    # script race ahead and `kill` this watchdog during reap_cgroup's own
    # TERM-then-KILL grace period, so a marker written afterwards never lands
    # and the warning is silently lost -- measured while building this.
    echo "swept" > "$log.swept"
    echo "⛔ modtest $module: limit ${limit_s}s elapsed and the lane is still up — sweeping the cgroup." >&2
    reap_cgroup "$$" "$BASHPID"
) &
watchdog=$!

if [[ "$mode" == file ]]; then
    # One file, one binary, same cap and same byte budget, plus a wall-clock
    # limit -- a mutant that loops forever prints forever, and a byte budget
    # alone only bounds how much of it we KEEP, not how long it runs.
    # (`--test-timeout` is a `zig build` flag; `zig test` rejects it.)
    timeout "${ZIGLIBS_MODTEST_TIMEOUT:-120s}" zig test "$probe" "$@" 2>&1 \
        | head -c "$ZIGLIBS_MODTEST_LOG_MAX" > "$log"
else
    # Wall-clock limit on the lane too, not just on `--file`. Measured
    # 2026-09-10: a ReleaseFast `test-dnssec` sat at 99% of one core with a
    # flat 3.2 MB RSS for 53 minutes -- an infinite loop, which no memory cap
    # and no byte budget can see, because it neither allocates nor prints.
    # A lane that hits this is a finding, and the exit code says so (124).
    timeout "${ZIGLIBS_MODTEST_TIMEOUT:-900s}" \
        zig build "test-$module" -j"$JOBS" --summary all "$@" 2>&1 \
        | head -c "$ZIGLIBS_MODTEST_LOG_MAX" > "$log"
fi
# pipefail makes this the BUILD's status, not `head`'s -- a truncated log must
# not read as a green build.
rc=$?

# If the watchdog already fired, let it FINISH its own sweep rather than killing
# it mid-flight -- otherwise its TERM-then-KILL grace `sleep` is still alive when
# the second sweep runs and gets reported as a stray, which is noise on top of a
# real warning.
if [[ -f "$log.swept" ]]; then
    wait "$watchdog" 2>/dev/null
else
    # ⛔ Kill the watchdog's CHILDREN first. `kill $watchdog` ends the subshell
    # but not the `sleep` it is blocked in -- that sleep is reparented, stays in
    # the cgroup, and the sweep below then reports it as a stray on EVERY run.
    # A false alarm on every run is worse than no alarm: it teaches the reader
    # to ignore the real one. (Reported by a fixer agent 2026-09-11 as
    # "stray: sleep 930" on all eight of its lanes.)
    kids=$(ps -o pid= --ppid "$watchdog" 2>/dev/null || true)
    # shellcheck disable=SC2086
    [[ -n "$kids" ]] && kill $kids 2>/dev/null
    kill "$watchdog" 2>/dev/null
    wait "$watchdog" 2>/dev/null
fi

# Second sweep, for the ordinary case: the lane finished on its own but left
# something behind. `head` has already exited here, so nothing is blocked --
# this is purely about not leaking a spinning process onto the user's desktop.
strays_found=0
reap_cgroup "$$" || strays_found=$?

swept=0
if [[ -f "$log.swept" ]]; then swept=1; rm -f "$log.swept"; fi


bytes=$(stat -c %s "$log" 2>/dev/null || echo 0)
budget=$(numfmt --from=iec "$ZIGLIBS_MODTEST_LOG_MAX" 2>/dev/null || echo 0)

echo "── modtest $module ── exit $rc, log $log ($(numfmt --to=iec "$bytes" 2>/dev/null || echo "$bytes")B)"

if [[ "$rc" == 124 ]]; then
    echo "⛔ TIMED OUT after ${ZIGLIBS_MODTEST_TIMEOUT:-900s} — a lane that neither" >&2
    echo "   finishes nor allocates is an infinite loop, and that IS the finding." >&2
fi

# A lane that hits the byte budget is a finding in its own right, not a detail:
# it is the shape that killed the editor.
if [[ "$budget" != 0 && "$bytes" -ge "$budget" ]]; then
    echo "⛔ OUTPUT HIT THE ${ZIGLIBS_MODTEST_LOG_MAX} BUDGET — this lane writes without bound." >&2
    echo "   Do NOT re-run it through a pipe. Diagnose from the log head:" >&2
    echo "   head -c 4000 $log" >&2
fi

if [[ "$swept" == 1 ]]; then
    echo "⛔ THE WATCHDOG HAD TO SWEEP — the lane outlived its ${limit_s}s limit and" >&2
    echo "   something it spawned was still holding the output pipe open. A test" >&2
    echo "   binary that survives its own build IS the finding; write it down." >&2
elif [[ "$strays_found" != 0 ]]; then
    echo "⛔ $strays_found STRAY PROCESS(ES) — the lane finished but left something running." >&2
    echo "   Write it into the disposition; a runaway that survives its build is a defect." >&2
fi

tail -c 200000 "$log" | tail -n "$LINES"
exit "$rc"
