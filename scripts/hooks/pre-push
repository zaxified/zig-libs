#!/usr/bin/env bash
# Refuse to push a release tag whose message still holds tag.sh's placeholder.
#
# scripts/tag.sh used to write "WHAT CHANGED SINCE <prev>: <<< fill this in before
# pushing ... >>>" into the annotated tag's message. Since 2026-11-02 the message
# is generated (scripts/lib/release-notes.py), so this guards only a tag cut by
# the older script and still local. Once pushed, a message is permanent (tag
# 2026-10-19 went out with the placeholder; the Release text had to carry the
# section instead). Enabled by core.hooksPath=scripts/hooks.
#
# Also runs `scripts/test.sh checks-fast` before ANY push that sends commits or
# a tag (owner, 2026-11-11): every static check that compiles nothing heavy,
# ~30 s, so a stale pin or a forbidden allocator is refused here instead of
# turning a full CI run red after 20 minutes. Full compiles stay on GitHub
# (push CI and full CI). Deleting a remote ref skips it. Escape hatch for an
# emergency only: ZIGLIBS_SKIP_PREPUSH=1 git push ...
set -euo pipefail

bad=0
sends=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
    [[ "$local_sha" =~ ^0+$ ]] || sends=1
    [[ "$local_ref" == refs/tags/* ]] || continue
    [[ "$local_sha" =~ ^0+$ ]] && continue   # deleting a remote tag
    [[ "$(git cat-file -t "$local_sha")" == tag ]] || continue
    if git cat-file -p "$local_sha" | grep -qF '<<< fill this in'; then
        echo "pre-push: ${local_ref#refs/tags/}: the tag message still holds tag.sh's \"WHAT CHANGED\" placeholder." >&2
        echo "          Fill it in first: git tag -a -f ${local_ref#refs/tags/} <commit> (keep the rest of the message)." >&2
        bad=1
    fi
done
(( bad )) && exit 1

if (( sends )) && [[ "${ZIGLIBS_SKIP_PREPUSH:-0}" != 1 ]]; then
    cd "$(git rev-parse --show-toplevel)"
    if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
        echo "pre-push: note: the working tree has uncommitted changes; checks-fast reads the tree, not the pushed commit." >&2
    fi
    run=(scripts/test.sh checks-fast)
    command -v hw >/dev/null && run=(hw run --name zl-pre-push --quiet 300 -- "${run[@]}")
    if ! "${run[@]}" >/tmp/zl-pre-push.log 2>&1; then
        grep -E 'FAIL|error:' /tmp/zl-pre-push.log | head -20 >&2
        echo "pre-push: checks-fast failed (full log: /tmp/zl-pre-push.log) -- push refused." >&2
        exit 1
    fi
    echo "pre-push: checks-fast OK" >&2
fi
exit 0
