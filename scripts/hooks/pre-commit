#!/usr/bin/env bash
# Refuse a commit whose STAGED Zig sources are not `zig fmt` clean.
#
# WHY THIS EXISTS. Formatting is gated in three places already — `scripts/
# test.sh all` fmt-checks the whole tree, `scripts/test.sh changed` fmt-checks
# the changed files, and CI runs `test.sh all` across four optimize matrices.
# None of them runs at COMMIT time, so all three are gates you have to remember
# to reach. `a23a933` ("rdap, taproot: restore zig fmt compliance") is what that
# costs: drift reached committed code in a repo that had a format gate the
# whole time.
#
# ⚠ Formatting drift does NOT change behaviour — Zig compiles a badly laid out
# file to exactly the same thing. What it breaks is the GATE, and a gate that
# goes red for a reason nobody caused on purpose is a gate people learn to
# ignore. That is the damage being prevented here, not a miscompile.
#
# WHY IT READS THE INDEX, NOT THE WORKING TREE. `git stash`-free correctness:
# what gets committed is the staged content, so that is what must be checked.
# Checking the worktree passes a commit whose staged half is unformatted (stage
# a clean version, then keep editing) and fails one whose staged half is fine.
# Each staged blob is therefore piped through `zig fmt --check --stdin`.
#
# INSTALL (hooks are not versioned by git, so point git at this directory):
#
#     git config core.hooksPath scripts/hooks
#
# BYPASS, when you mean it: `git commit --no-verify`.

set -u

# Only files that will exist in the commit: Added, Copied, Modified. Deletions
# and renames-away have no content to check.
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM -z |
    tr '\0' '\n' | grep -E '\.(zig|zon)$' || true)

[[ ${#staged[@]} -eq 0 ]] && exit 0

bad=()
for f in "${staged[@]}"; do
    [[ -z "$f" ]] && continue
    # `--zon` is a whole-invocation switch, so `.zon` is checked separately
    # rather than mixed into one call.
    if [[ "$f" == *.zon ]]; then
        git show ":$f" | zig fmt --check --zon --stdin >/dev/null 2>&1 || bad+=("$f")
    else
        git show ":$f" | zig fmt --check --stdin >/dev/null 2>&1 || bad+=("$f")
    fi
done

if [[ ${#bad[@]} -gt 0 ]]; then
    echo "pre-commit: these staged files are not \`zig fmt\` clean:" >&2
    printf '  %s\n' "${bad[@]}" >&2
    echo >&2
    echo "Fix and re-stage:" >&2
    printf '  zig fmt %s\n' "${bad[*]}" >&2
    printf '  git add %s\n' "${bad[*]}" >&2
    echo >&2
    echo "Formatting only — this cannot have changed behaviour. --no-verify bypasses." >&2
    exit 1
fi

exit 0
