RISCV deque-popsteal-riscv-relaxed
(* Chase-Lev deque pop/steal Dekker interlock — POSITIVE CONTROL (ordering
 * DELIBERATELY WEAKENED: plain sd/ld, all fences removed, and the claiming
 * RMW is amoswap.w with no aq/rl). Proves the barriers are load-bearing: both
 * sides can miss each other (owner and thief take the same item). Under
 * riscv.cat this MUST be Sometimes/Allowed. *)
{
0:x5=bottom; 0:x6=top;
1:x6=top; 1:x5=bottom;
}
 P0               | P1                     ;
 ori x1,x0,1      | ori x1,x0,1            ;
 sd x1,0(x5)      | amoswap.w x3,x1,0(x6)  ;
 lw x2,0(x6)      | ld x2,0(x5)            ;
exists
(0:x2=0 /\ 1:x2=0)
