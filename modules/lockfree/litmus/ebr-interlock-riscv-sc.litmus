RISCV ebr-interlock-riscv-sc
(* EBR pin/scan Dekker interlock — SAFE variant (the ordering the code uses).
 * Shape: store-buffering (SB).
 *   P0 = reader (enterCritical): STORE local_epoch (pin) then LOAD shared ptr.
 *   P1 = reclaimer (tryAdvance): STORE unlink/advance then LOAD local_epoch.
 * seq_cst lowering per SPEC.md 7:
 *   seq_cst store -> fence rw,w ; sd
 *   seq_cst load  -> fence rw,rw ; ld ; fence r,rw
 * The leading "fence rw,rw" on the load is the RISC-V analog of ARM RCsc ldar:
 * it orders the prior seq_cst store before this load (the store->load barrier).
 * The SB non-SC bug outcome (both loads read stale = UAF) MUST be Never. *)
{
0:x5=pin; 0:x6=ptr;
1:x5=ptr; 1:x6=pin;
}
 P0               | P1               ;
 ori x1,x0,1      | ori x1,x0,1      ;
 fence rw,w       | fence rw,w       ;
 sd x1,0(x5)      | sd x1,0(x5)      ;
 fence rw,rw      | fence rw,rw      ;
 ld x2,0(x6)      | ld x2,0(x6)      ;
 fence r,rw       | fence r,rw       ;
exists
(0:x2=0 /\ 1:x2=0)
