.{
    .name = .tiny_mtr,
    .version = "0.0.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0xb3134ec44630b681,
    .paths = .{ "build.zig", "build.zig.zon", "src", "init.sh", "smoke.sh", "smoke_tty.py", "README.md" },
    .dependencies = .{
        // Pinned to a dated release tag. A tag asserts one thing: every module
        // cleared every lane at that commit. Bumped by the commit under each
        // new tag, so a copy taken from tag T is built against T.
        .zig_libs = .{
            .url = "git+https://github.com/zaxified/zig-libs#2026-11-02",
            .hash = "zig_libs-0.0.0-WiQ0GuOIIgkzMoaRE7R-YI5w40vEd031C4TR1semIhz2",
        },
        // To follow the development branch instead, or to pin one commit,
        // replace the two lines above with one of these and run
        // `zig fetch --save <url>` to fill in the matching hash:
        //
        //   .url = "git+https://github.com/zaxified/zig-libs#main",
        //   .url = "git+https://github.com/zaxified/zig-libs#<40-char-commit-sha>",
        //
        // Both are content-pinned by `.hash` all the same, so neither floats:
        // `#main` stops resolving the moment main moves. Only the tag is a
        // stable point, and only the tag carries the all-lanes-green claim.
    },
}
